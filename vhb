-- =============================================
-- ПРОЦЕДУРА: Отмена бронирования
-- =============================================

CREATE OR REPLACE PROCEDURE cancel_booking(p_booking_id NUMBER) IS
BEGIN
    UPDATE Bookings 
    SET status = 'CANCELLED' 
    WHERE booking_id = p_booking_id;
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Бронирование ' || p_booking_id || ' отменено');
END;
/

-- =============================================
-- ФУНКЦИЯ: Получить загрузку отеля по датам
-- =============================================

CREATE OR REPLACE FUNCTION get_occupancy_rate(p_start_date DATE, p_end_date DATE)
RETURN NUMBER IS
    v_total_rooms NUMBER;
    v_booked_rooms NUMBER;
    v_rate NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_total_rooms FROM Rooms;
    
    SELECT COUNT(DISTINCT room_id) INTO v_booked_rooms
    FROM Bookings
    WHERE status = 'CONFIRMED'
      AND NOT (p_end_date <= check_in_date OR p_start_date >= check_out_date);
    
    IF v_total_rooms > 0 THEN
        v_rate := (v_booked_rooms / v_total_rooms) * 100;
    ELSE
        v_rate := 0;
    END IF;
    
    RETURN ROUND(v_rate, 2);
END;
/

