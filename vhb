-- =============================================
-- БИЗНЕС-ТРИГГЕРЫ
-- =============================================

-- Триггер 1: Автоматический расчёт total_price при бронировании
CREATE OR REPLACE TRIGGER trg_bookings_calc_price
BEFORE INSERT OR UPDATE OF check_in_date, check_out_date, room_id ON Bookings
FOR EACH ROW
DECLARE
    v_room_price NUMBER;
    v_nights NUMBER;
BEGIN
    -- Получаем цену номера
    SELECT price INTO v_room_price FROM Rooms WHERE room_id = :NEW.room_id;
    
    -- Рассчитываем количество ночей
    v_nights := :NEW.check_out_date - :NEW.check_in_date;
    
    -- Устанавливаем общую цену
    :NEW.total_price := v_room_price * v_nights;
END;
/

-- Триггер 2: Проверка, что номер свободен на выбранные даты
CREATE OR REPLACE TRIGGER trg_bookings_check_availability
BEFORE INSERT OR UPDATE OF check_in_date, check_out_date, room_id ON Bookings
FOR EACH ROW
DECLARE
    v_conflict_count NUMBER;
BEGIN
    IF :NEW.status != 'CANCELLED' THEN
        SELECT COUNT(*)
        INTO v_conflict_count
        FROM Bookings
        WHERE room_id = :NEW.room_id
          AND status != 'CANCELLED'
          AND booking_id != NVL(:OLD.booking_id, -1)
          AND NOT (:NEW.check_out_date <= check_in_date OR 
                   :NEW.check_in_date >= check_out_date);
        
        IF v_conflict_count > 0 THEN
            RAISE_APPLICATION_ERROR(-20001, 'Номер уже забронирован на выбранные даты!');
        END IF;
    END IF;
END;
/

-- Триггер 3: При успешном бронировании меняем статус комнаты
CREATE OR REPLACE TRIGGER trg_bookings_update_room_status
AFTER INSERT OR UPDATE OF status ON Bookings
FOR EACH ROW
BEGIN
    IF :NEW.status = 'CONFIRMED' THEN
        UPDATE Rooms SET is_available = 'N' 
        WHERE room_id = :NEW.room_id;
    ELSIF :NEW.status IN ('CANCELLED', 'COMPLETED') THEN
        UPDATE Rooms SET is_available = 'Y' 
        WHERE room_id = :NEW.room_id;
    END IF;
END;
/

-- Триггер 4: Проверка дат (заезд не может быть раньше сегодня)
CREATE OR REPLACE TRIGGER trg_bookings_dates
BEFORE INSERT OR UPDATE OF check_in_date ON Bookings
FOR EACH ROW
BEGIN
    IF :NEW.check_in_date < TRUNC(SYSDATE) THEN
        RAISE_APPLICATION_ERROR(-20002, 'Дата заезда не может быть в прошлом!');
    END IF;
END;
/

-- Триггер 5: Автоматическая отметка времени платежа
CREATE OR REPLACE TRIGGER trg_payments_date
BEFORE INSERT ON Payments
FOR EACH ROW
BEGIN
    IF :NEW.payment_date IS NULL THEN
        :NEW.payment_date := SYSDATE;
    END IF;
END;
/

-- Триггер 6: Проверка суммы платежа (не больше общей суммы бронирования)
CREATE OR REPLACE TRIGGER trg_payments_check_amount
BEFORE INSERT OR UPDATE OF amount ON Payments
FOR EACH ROW
DECLARE
    v_total_price NUMBER;
BEGIN
    SELECT total_price INTO v_total_price 
    FROM Bookings WHERE booking_id = :NEW.booking_id;
    
    IF :NEW.amount > v_total_price THEN
        RAISE_APPLICATION_ERROR(-20003, 'Сумма платежа не может превышать общую стоимость бронирования!');
    END IF;
END;
/

