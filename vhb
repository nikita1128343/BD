-- =============================================
-- СОЗДАНИЕ ТАБЛИЦ
-- =============================================

-- 1. Таблица Guests (гости)
CREATE TABLE Guests (
    guest_id     NUMBER PRIMARY KEY,
    first_name   VARCHAR2(50) NOT NULL,
    last_name    VARCHAR2(50) NOT NULL,
    phone        VARCHAR2(20),
    email        VARCHAR2(100) UNIQUE,
    created_date DATE DEFAULT SYSDATE
);

-- 2. Таблица Room_Types (типы номеров)
CREATE TABLE Room_Types (
    type_id     NUMBER PRIMARY KEY,
    type_name   VARCHAR2(50) NOT NULL UNIQUE,
    description CLOB,
    base_price  NUMBER(10,2) NOT NULL,
    created_date DATE DEFAULT SYSDATE
);

-- 3. Таблица Rooms (номера)
CREATE TABLE Rooms (
    room_id      NUMBER PRIMARY KEY,
    room_number  VARCHAR2(10) NOT NULL UNIQUE,
    price        NUMBER(10,2) NOT NULL,
    capacity     NUMBER NOT NULL,
    type_id      NUMBER,
    is_available CHAR(1) DEFAULT 'Y',
    created_date DATE DEFAULT SYSDATE,
    CONSTRAINT fk_rooms_type FOREIGN KEY (type_id) 
        REFERENCES Room_Types(type_id) ON DELETE SET NULL,
    CONSTRAINT chk_rooms_capacity CHECK (capacity > 0),
    CONSTRAINT chk_rooms_price CHECK (price >= 0),
    CONSTRAINT chk_rooms_available CHECK (is_available IN ('Y', 'N'))
);

-- 4. Таблица Bookings (бронирования)
CREATE TABLE Bookings (
    booking_id     NUMBER PRIMARY KEY,
    guest_id       NUMBER NOT NULL,
    room_id        NUMBER NOT NULL,
    check_in_date  DATE NOT NULL,
    check_out_date DATE NOT NULL,
    status         VARCHAR2(20) DEFAULT 'CONFIRMED',
    total_price    NUMBER(10,2),
    created_date   DATE DEFAULT SYSDATE,
    CONSTRAINT fk_bookings_guest FOREIGN KEY (guest_id) 
        REFERENCES Guests(guest_id) ON DELETE CASCADE,
    CONSTRAINT fk_bookings_room FOREIGN KEY (room_id) 
        REFERENCES Rooms(room_id) ON DELETE CASCADE,
    CONSTRAINT chk_bookings_dates CHECK (check_out_date > check_in_date),
    CONSTRAINT chk_bookings_status CHECK (status IN ('CONFIRMED', 'CANCELLED', 'COMPLETED', 'PENDING'))
);

-- 5. Таблица Payments (платежи)
CREATE TABLE Payments (
    payment_id   NUMBER PRIMARY KEY,
    booking_id   NUMBER NOT NULL,
    amount       NUMBER(10,2) NOT NULL,
    payment_date DATE DEFAULT SYSDATE,
    method       VARCHAR2(30),
    status       VARCHAR2(20) DEFAULT 'COMPLETED',
    CONSTRAINT fk_payments_booking FOREIGN KEY (booking_id) 
        REFERENCES Bookings(booking_id) ON DELETE CASCADE,
    CONSTRAINT chk_payments_amount CHECK (amount > 0),
    CONSTRAINT chk_payments_method CHECK (method IN ('CASH', 'CREDIT_CARD', 'DEBIT_CARD', 'ONLINE', 'BANK_TRANSFER')),
    CONSTRAINT chk_payments_status CHECK (status IN ('COMPLETED', 'PENDING', 'FAILED', 'REFUNDED'))
);

-- =============================================
-- СОЗДАНИЕ ПОСЛЕДОВАТЕЛЬНОСТЕЙ (SEQUENCES)
-- =============================================

CREATE SEQUENCE seq_guests START WITH 1 INCREMENT BY 1;
CREATE SEQUENCE seq_room_types START WITH 1 INCREMENT BY 1;
CREATE SEQUENCE seq_rooms START WITH 1 INCREMENT BY 1;
CREATE SEQUENCE seq_bookings START WITH 1 INCREMENT BY 1;
CREATE SEQUENCE seq_payments START WITH 1 INCREMENT BY 1;

-- =============================================
-- ТРИГГЕРЫ ДЛЯ АВТО-ИНКРЕМЕНТА (BEFORE INSERT)
-- =============================================

-- Триггер для Guests
CREATE OR REPLACE TRIGGER trg_guests_id
BEFORE INSERT ON Guests
FOR EACH ROW
BEGIN
    IF :NEW.guest_id IS NULL THEN
        SELECT seq_guests.NEXTVAL INTO :NEW.guest_id FROM DUAL;
    END IF;
END;
/

